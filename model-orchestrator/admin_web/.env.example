# Model orchestrator admin console: configuration.
# Copy to .env and fill in. Never commit the copy.

# --- database (required) -----------------------------------------------------
# The same Postgres the router uses. The console reads and writes api_keys,
# reads the usage tables and writes admin_audit. It never creates tables.
ADMIN_DATABASE_URL=postgresql://orchestrator:change-me@127.0.0.1:5432/orchestrator
# Seconds to wait for a connection before showing "database unreachable".
#ADMIN_DATABASE_TIMEOUT_SECONDS=5

# --- router status (optional) ------------------------------------------------
# Base URL of the router. Only GET /health and GET /v1/models are called.
# Leave unset to run without live status.
#ADMIN_ROUTER_URL=http://127.0.0.1:8090
# How fast the router picks up key changes (its ROUTER_KEYS_REFRESH_SECONDS).
# Only used in the wording of confirmations.
#ADMIN_KEY_REFRESH_SECONDS=15

# --- sessions ----------------------------------------------------------------
# Signs the session cookie. At least 32 characters: `openssl rand -hex 32`.
# Without it a random secret is used and every restart signs everyone out.
ADMIN_SESSION_SECRET=
# Absolute lifetime in hours (1 to 72) and idle timeout in minutes.
#ADMIN_SESSION_HOURS=8
#ADMIN_SESSION_IDLE_MINUTES=60

# --- single sign-on (OpenID Connect) -----------------------------------------
# Setting the issuer switches it on. All three of issuer, client id and
# required role are then mandatory.
#ADMIN_OIDC_ISSUER=https://keycloak.example.org/realms/example
#ADMIN_OIDC_CLIENT_ID=model-orchestrator-admin
#ADMIN_OIDC_CLIENT_SECRET=
#ADMIN_OIDC_REQUIRED_ROLE=router-admin
# The issuer as this process reaches it, when that differs from the address
# browsers use: the console then fetches the provider's settings, keys and
# tokens there, and only the browser goes to the issuer. For a provider on
# the same host behind a proxy whose certificate programs cannot verify.
# https, or plain http for localhost only.
#ADMIN_OIDC_INTERNAL_URL=http://127.0.0.1:8601/realms/example
# Where the roles are in the token. Keycloak realm roles: realm_access.roles
# Keycloak client roles: resource_access.<client id>.roles
#ADMIN_OIDC_ROLE_CLAIM=realm_access.roles
#ADMIN_OIDC_SCOPES=openid profile email
#ADMIN_OIDC_USERNAME_CLAIM=preferred_username
# Text on the button: "Continue with <label>".
#ADMIN_OIDC_LABEL=single sign-on

# --- local account (development and break-glass) -----------------------------
# Active when a password is set and ADMIN_LOCAL_LOGIN is not "off".
# The password must have at least 12 characters, or the console does not
# start: `openssl rand -base64 24`. Changing it signs the local account out.
#ADMIN_LOCAL_LOGIN=on
#ADMIN_LOCAL_USER=admin
#ADMIN_LOCAL_PASSWORD=
# Failed attempts before a source address is locked out, and the first lock
# in seconds (each further lock doubles, up to 15 minutes). Failures from all
# addresses together only slow sign-in down; they never lock it.
#ADMIN_LOGIN_MAX_ATTEMPTS=5
#ADMIN_LOGIN_LOCKOUT_SECONDS=60

# --- serving -----------------------------------------------------------------
# Keep 127.0.0.1 whenever the TLS proxy runs on the same host or the
# container uses host networking: proxy headers are trusted by default, so
# nobody but the proxy may reach this port.
#ADMIN_HOST=127.0.0.1
#ADMIN_PORT=8600
# The address users type, when a proxy is in front. Used for the OIDC
# redirect URI and to decide that cookies must be Secure.
#ADMIN_PUBLIC_URL=https://admin.example.org
# Believe X-Forwarded-Proto / -Host / -For. Switch off when the console is
# reachable without a proxy in front.
#ADMIN_TRUST_PROXY_HEADERS=on
#ADMIN_SITE_NAME=Model Orchestrator
