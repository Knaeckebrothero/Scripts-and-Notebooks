# Copy to ~/.config/model-orchestrator/admin-web.env and chmod 600.
# Read by admin-web.container. All variables: ../admin_web/.env.example

# The router's database. The password must match db.env.
ADMIN_DATABASE_URL=postgresql://orchestrator:change-me@127.0.0.1:5432/orchestrator

# The router, for live route status (GET /health and GET /v1/models only).
ADMIN_ROUTER_URL=http://127.0.0.1:8091

# Signs the session cookie. At least 32 characters: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# The https address people type, as nginx serves it. Set it: cookies are then
# always Secure, HSTS is sent, and the single sign-on redirect does not depend
# on request headers.
ADMIN_PUBLIC_URL=https://admin.example.org:8501

# Session lifetime in hours (default 8, at most 72) and idle limit in minutes.
#ADMIN_SESSION_HOURS=8
#ADMIN_SESSION_IDLE_MINUTES=60

# Sign-in. Either single sign-on (OpenID Connect, for example Keycloak) ...
#ADMIN_OIDC_ISSUER=https://keycloak.example.org/realms/example
#ADMIN_OIDC_CLIENT_ID=model-orchestrator-admin
#ADMIN_OIDC_CLIENT_SECRET=
#ADMIN_OIDC_REQUIRED_ROLE=router-admin
# With keycloak.container on this host: the website talks to Keycloak over
# loopback and does not need to verify the public certificate.
#ADMIN_OIDC_INTERNAL_URL=http://127.0.0.1:8601/realms/example

# ... or the local account (also the break-glass login when the identity
# provider is down). The password needs at least 12 characters, or the website
# does not start: openssl rand -base64 24. Left empty, the local account is
# off. ADMIN_LOCAL_LOGIN=off removes it for good once single sign-on works.
ADMIN_LOCAL_USER=admin
ADMIN_LOCAL_PASSWORD=
