# admin-ui.container: the old Streamlit admin UI (admin_ui/)
#
# Still deployable until the admin website (admin-web.container) has replaced
# it. Listens on 127.0.0.1:8502; to serve it, set UI_UPSTREAM in
# nginx.container to http://127.0.0.1:8502 (websocket upgrade included).
# Credentials and the database URL: ~/.config/model-orchestrator/admin-ui.env
# (chmod 600), see admin-ui.env.example next to this file.
[Unit]
Description=Model Orchestrator admin UI (Streamlit)
After=network-online.target orchestrator-db.service
Wants=network-online.target

[Container]
ContainerName=orchestrator-admin-ui
# `latest` moves only on a release tag (model-orchestrator-admin-ui-vX.Y.Z);
# every build of main is published as `sha-<short>`.
Image=ghcr.io/knaeckebrothero/model-orchestrator-admin-ui:latest
AutoUpdate=registry
Network=host

EnvironmentFile=%h/.config/model-orchestrator/admin-ui.env
Environment=STREAMLIT_SERVER_ADDRESS=127.0.0.1
Environment=STREAMLIT_SERVER_PORT=8502

HealthCmd=python -c "import sys,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8502/_stcore/health', timeout=5); sys.exit(0 if r.status==200 else 1)"
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=15s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
