# Copy to ~/.config/model-orchestrator/router.env and chmod 600.
# Read by model-orchestrator.container (EnvironmentFile).

# Required. The password must match db.env. The role needs to create tables:
# the router applies its schema migrations at start.
ROUTER_DATABASE_URL=postgresql://orchestrator:change-me@127.0.0.1:5432/orchestrator

# One line per route that sets backend_api_key_env in the config, and per
# upstream that sets api_key_env. The variable names are yours to choose.
#TUNNEL_CHAT_API_KEY=
#SITE_A_ROUTER_API_KEY=

# Everything else has a default. README.md lists all variables. Common ones:
#ROUTER_LOG_FORMAT=json
#ROUTER_HEALTH_GATING=off
#CHAT_READ_TIMEOUT_S=600
#ROUTER_DEFAULT_MAX_CONCURRENCY=8
