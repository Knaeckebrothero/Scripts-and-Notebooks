# Template. Copy to secret.yaml, fill in the values, then:
#   kubectl apply -f secret.yaml
# Do not commit the filled-in file.
#
# API keys for clients are not configured here or in any YAML: they live in
# Postgres and are managed in the admin website.
apiVersion: v1
kind: Secret
metadata:
  name: model-orchestrator-keys
  namespace: model-orchestrator
  labels:
    app.kubernetes.io/name: model-orchestrator
type: Opaque
stringData:
  # Postgres for the router and the admin website. The role needs to create
  # tables: the router applies its schema migrations at start.
  database-url: "postgresql://orchestrator:change-me@postgres.example.svc:5432/orchestrator"

  # Admin website (admin-web.yaml). The website does not start with the two
  # placeholders below: they are too short on purpose.
  # Session secret, at least 32 characters: openssl rand -hex 32
  admin-session-secret: "change-me"
  # Password of the local account, at least 12 characters: openssl rand -base64 24
  # With single sign-on set up you can remove it and set ADMIN_LOCAL_LOGIN=off
  # in admin-web.yaml.
  admin-local-password: "change-me"
  # admin-oidc-client-secret: ""

  # One entry per route that sets backend_api_key_env (see deployment.yaml):
  # tunnel-chat-api-key: ""
