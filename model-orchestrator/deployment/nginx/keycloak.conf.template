# TLS termination for Keycloak next to the router. Optional: only for a site
# that runs its own Keycloak for signing in to the admin website
# (keycloak.container).
#
# A second nginx template, mounted next to orchestrator.conf.template (see
# nginx.container). All three variables must be set there:
#
#   KEYCLOAK_LISTEN       the public https port, for example 8443
#   KEYCLOAK_UPSTREAM     http://127.0.0.1:8601
#   KEYCLOAK_ADMIN_FROM   who may reach the administration console and the
#                         realm of Keycloak's own administrators: a network
#                         such as 192.0.2.0/24, one address, or `all`
#
# Sign-in pages (the realms and their static files) are open to everyone who
# reaches the port. Everything else answers 404; health and metrics are not
# switched on in keycloak.container.

server {
    listen ${KEYCLOAK_LISTEN} ssl;
    http2 on;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # Keycloak's response headers (cookies, tokens in redirects) do not fit
    # nginx's default 4k buffer.
    proxy_buffer_size       16k;
    proxy_buffers           8 16k;
    proxy_busy_buffers_size 32k;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    # nginx is the edge: what the client claims in these headers is dropped.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;

    # The administration console, its API, and the realm its administrators
    # sign in to. Keycloak redirects a browser to its one public address, so
    # these cannot be kept on loopback; they are limited by source address.
    location /admin/ {
        allow ${KEYCLOAK_ADMIN_FROM};
        deny all;
        proxy_pass ${KEYCLOAK_UPSTREAM};
    }

    location /realms/master/ {
        allow ${KEYCLOAK_ADMIN_FROM};
        deny all;
        proxy_pass ${KEYCLOAK_UPSTREAM};
    }

    location /realms/ {
        proxy_pass ${KEYCLOAK_UPSTREAM};
    }

    location /resources/ {
        proxy_pass ${KEYCLOAK_UPSTREAM};
    }

    location / {
        return 404;
    }
}
