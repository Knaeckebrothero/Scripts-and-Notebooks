# model-orchestrator.container — OpenAI API-compatible gateway
#
# Runs loopback-only on 127.0.0.1:8091; the nginx unit (nginx.container)
# terminates TLS on the public :8090 and proxies here. Requires Postgres
# (orchestrator-db.container) — API keys and usage live there, managed via
# the admin UI (admin-ui.container).
[Unit]
Description=Model Orchestrator - OpenAI API-compatible gateway
After=network-online.target orchestrator-db.service
Wants=network-online.target

[Container]
ContainerName=model-orchestrator
# HISTORY: `:latest` is a tag, not a promise -- `systemctl restart` reuses the
# local image and does NOT re-pull. That cost us seven weeks: the 600s chat read
# timeout (commit 936767e, 2026-06-29, pushed to GHCR by CI the same day) sat
# undeployed behind a 2026-06-12 local image while the router kept enforcing the
# old 120s default, 503'ing every Muse Glimmer call that needed longer -- which
# is most DeepEval judge calls, at ~140s each. Found and fixed 2026-08-21.
#
# As of 2026-08-21 podman-auto-update.timer is ENABLED on this host (daily,
# RandomizedDelaySec=900), so with AutoUpdate=registry below this unit now
# tracks `:latest` unattended. That means whatever CI last pushed to main
# reaches this gateway within ~24h without review. Restart is ~6s and podman
# rolls back on healthcheck failure, but if you want a change gated, pin this
# to a `sha-<short>` tag instead -- auto-update is then a no-op, exactly as it
# already is for gemma4-moe-gpu1.
#
# MANUAL DEPLOY:  podman pull <image> && systemctl --user restart <unit>
# VERIFY:         podman inspect <ctr> --format '{{.ImageName}} {{.Image}}'
#                 and diff the running /app/main.py against the repo.
# CHECK DRIFT:    podman auto-update --dry-run    (read-only)
Image=ghcr.io/knaeckebrothero/model-orchestrator:latest
AutoUpdate=registry
Network=host

# Read-only bind mount of the YAML config (server + routes; no keys in YAML)
Volume=%h/.config/model-orchestrator/config.yaml:/app/config.yaml:ro,z

# ROUTER_DATABASE_URL lives in router.env (chmod 600, see router.env.example)
EnvironmentFile=%h/.config/model-orchestrator/router.env
# Loopback-only behind the nginx TLS terminator, which owns the public :8090.
Environment=ROUTER_HOST=127.0.0.1
Environment=ROUTER_PORT=8091
Environment=ROUTER_CONFIG=/app/config.yaml
Environment=ROUTER_LOG_LEVEL=INFO

# Use python+urllib (always present in the image, unlike curl) so podman can
# actually run the probe. Exits 0 on HTTP 200, non-zero otherwise.
HealthCmd=python -c "import sys,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=5); sys.exit(0 if r.status==200 else 1)"
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=15s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
