# model-orchestrator.container: the router (OpenAI-compatible API)
#
#   127.0.0.1:8091  the API, plain HTTP. nginx.container terminates TLS on the
#                   public port and proxies here.
#   127.0.0.1:9095  internal: Prometheus /metrics and the detailed /health with
#                   backend URLs. No auth. Never publish or proxy this port.
#
# Needs Postgres (orchestrator-db.container): keys and usage live there, and
# the router applies its own schema migrations at start.
[Unit]
Description=Model Orchestrator - OpenAI API-compatible gateway
After=network-online.target orchestrator-db.service
Wants=network-online.target

[Container]
ContainerName=model-orchestrator
# Image tags: `latest` and `vX.Y.Z` are published only when a release is
# tagged; every build of main is published as `sha-<short>`. With
# AutoUpdate=registry and podman-auto-update.timer enabled, this unit follows
# releases unattended. To hold a version, pin `vX.Y.Z` or `sha-<short>` here.
# A plain `systemctl restart` never pulls. To update by hand:
#   podman pull <image> && systemctl --user restart model-orchestrator
# What is running:  curl -s http://127.0.0.1:9095/health  (version, git_sha)
Image=ghcr.io/knaeckebrothero/model-orchestrator:latest
AutoUpdate=registry
Network=host
# On stop the router gives requests in flight ROUTER_SHUTDOWN_GRACE_SECONDS
# (default 8) and then ends them with an answer. That fits Podman's stop
# timeout of 10 s. To give long requests more time, raise all three together:
#   Environment=ROUTER_SHUTDOWN_GRACE_SECONDS=25
#   StopTimeout=30
#   and TimeoutStopSec=45 in [Service] below

# The route config: no keys and no secrets in it. Check a change first:
#   podman run --rm -v <file>:/app/config.yaml:ro,z <image> \
#     python -m model_orchestrator check-config /app/config.yaml
# The router reloads the file when it changes, but a single-file mount only
# shows edits made in place. An editor that replaces the file needs
# `systemctl --user restart model-orchestrator`, or mount a directory:
#   Volume=%h/.config/model-orchestrator/routes:/etc/model-orchestrator:ro,z
#   Environment=ROUTER_CONFIG=/etc/model-orchestrator/config.yaml
Volume=%h/.config/model-orchestrator/config.yaml:/app/config.yaml:ro,z
Environment=ROUTER_CONFIG=/app/config.yaml

# ROUTER_DATABASE_URL and backend keys: router.env (chmod 600), see router.env.example
EnvironmentFile=%h/.config/model-orchestrator/router.env
Environment=ROUTER_HOST=127.0.0.1
Environment=ROUTER_PORT=8091
Environment=ROUTER_METRICS_PORT=9095

# /livez answers as long as the process runs. It touches neither the database
# nor a backend, so an outage elsewhere never restarts the router. python is
# always in the image; curl is not.
HealthCmd=python -c "import sys,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8091/livez', timeout=3); sys.exit(0 if r.status==200 else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
# The start waits up to 60 s for Postgres, then applies migrations and probes
# every backend once.
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
