# Copy to ~/.config/model-orchestrator/keycloak.env and chmod 600.
# Read by keycloak.container.

# The public https address, exactly as browsers reach it through nginx
# (KEYCLOAK_LISTEN in nginx.container). Tokens name this address as issuer,
# and the administration console is at <this address>/admin/.
KC_HOSTNAME=https://sso.example.org:8443

# Its own database in the router's Postgres. The port must match the one
# orchestrator-db listens on.
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me

# Creates a temporary administrator at the first start, when none exists.
# Sign in with it once, create your own administrator account in the realm
# "master", delete this one, then remove these two lines.
# openssl rand -base64 24
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Used by the realm file in keycloak/import (see deployment/keycloak/):
# the realm's name, and the https address of the admin website
# (ADMIN_PUBLIC_URL in admin-web.env), without a trailing slash.
SSO_REALM=example
ROUTER_ADMIN_URL=https://admin.example.org:8501
