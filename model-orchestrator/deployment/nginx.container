# nginx.container: TLS termination in front of the router and one admin UI
#
#   :8090 https  ->  ROUTER_UPSTREAM  the router (ROUTER_HOST=127.0.0.1, port 8091)
#   :8501 https  ->  UI_UPSTREAM      the admin website (port 8600), or the old
#                                     Streamlit UI (port 8502) until it is retired
#
# The router's internal port (9095) is not proxied, on purpose.
#
# Expects on the host:
#   ~/.config/model-orchestrator/nginx/orchestrator.conf.template  (from deployment/nginx/)
#   ~/.config/model-orchestrator/certs/server.crt                  (certificate and chain)
#   ~/.config/model-orchestrator/certs/server.key                  (chmod 600)
[Unit]
Description=nginx TLS termination for model-orchestrator and its admin UI
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=orchestrator-nginx
Image=docker.io/library/nginx:1.27-alpine
Network=host

# The entrypoint runs envsubst over *.template into /etc/nginx/conf.d/ at start.
Volume=%h/.config/model-orchestrator/nginx/orchestrator.conf.template:/etc/nginx/templates/default.conf.template:ro,z
Volume=%h/.config/model-orchestrator/certs:/etc/nginx/certs:ro,z

Environment=ROUTER_UPSTREAM=http://127.0.0.1:8091
# The admin website (admin-web.container). For the Streamlit UI
# (admin-ui.container) use http://127.0.0.1:8502 instead.
Environment=UI_UPSTREAM=http://127.0.0.1:8600

# busybox wget. The certificate does not name 127.0.0.1, hence
# --no-check-certificate: this only checks that TLS termination and the
# router behind it answer.
HealthCmd=/bin/sh -c "wget -q -O /dev/null --no-check-certificate https://127.0.0.1:8090/livez"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
