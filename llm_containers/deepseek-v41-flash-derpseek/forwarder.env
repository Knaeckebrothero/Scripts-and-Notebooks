# Settings of deepseek-forwarder.service (see forwarder.py).
# Test phase: reachable from this host only, and from the isolated Docker network for the stress test.
# At cut-over: DSF_LISTEN gets the Station's own address and port 8000, DSF_ALLOW_API the router's address,
# DSF_ALLOW_METRICS the address the metrics are read from. Keep those addresses in this file only.
DSF_UPSTREAM=172.31.250.2:8112
DSF_LISTEN=127.0.0.1:8010,172.31.250.1:8010
DSF_MAX_ACTIVE=8
DSF_MAX_WAITING=64
DSF_MAX_BODY_MB=32
DSF_ALLOW_API=127.0.0.0/8,172.31.250.0/24
DSF_ALLOW_METRICS=
