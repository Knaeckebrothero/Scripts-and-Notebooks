# Used by deepseek-derpseek.service (systemd EnvironmentFile). Install as /etc/deepseek-derpseek/unit.env.
IMAGE=deepseek-v41-flash-derpseek:1.9-1
# The GB300's UUID: nvidia-smi --query-gpu=name,uuid --format=csv,noheader
GPU=GPU-00000000-0000-0000-0000-000000000000
MODEL=/srv/models/DeepSeek-V4.1-Flash-1017
STATE=/srv/vllm/ds-state
ENGINE_IP=172.31.250.2
ENGINE_PORT=8112
