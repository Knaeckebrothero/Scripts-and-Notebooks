# Settings of the engine container (docker --env-file: NAME=value, no quotes). See entrypoint.sh for the names.
# Decided on 21 Nov 2026: derpseek exact, the other expert layout, prompt staging kept, KV cache fixed at the
# tested size (8.82 GiB; with "whatever is left" vLLM gave 3,885,949 tokens).
DS_PROFILE=exact
ROWMAP=exact-splitA-varied-mm.json
KV_CACHE_BYTES=9470000000
# First name = the stock server's, so clients need no change when the engine behind the port changes.
DS_SERVED_NAMES=deepseek-ai/DeepSeek-V4.1-Flash deepseek-v4.1-flash deepseek DeepSeek-V4.1-Flash derpseek
# The launcher's warm-up switch; it has no meaning inside the container and is kept so the environment equals the tested one.
DSV41_WARM=0
# The 400k limit goes here once the test of this setting has passed (acceptance run, item 2):
# MAXLEN=400000
